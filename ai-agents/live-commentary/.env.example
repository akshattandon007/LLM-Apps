# Copy to .env and fill in. Nothing here is required for `commentary demo`.

# Enables the real Claude commentary engine (generates in any language).
ANTHROPIC_API_KEY=sk-ant-...
# Optional: pick the model. Haiku is fast & cheap and great for live pace.
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Only needed if you use the football-data.org provider.
FOOTBALL_DATA_API_KEY=
