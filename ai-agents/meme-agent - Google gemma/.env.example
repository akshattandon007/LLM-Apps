# ── Meme Agent — Environment Variables ──────────────────────────────────────
#
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# NEVER commit your actual .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# Required — get it free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional — get it free at https://unsplash.com/developers
# If not set, the agent falls back to Lorem Picsum (random photo, no sign-up)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
