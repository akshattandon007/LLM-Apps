# ════════════════════════════════════════════════════════════════════
# Flights Over Me — configuration. Copy to `.env` and edit.
# Every value below is OPTIONAL: the app runs fully anonymous out of the box.
# All variables are prefixed FOM_.
# ════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
FOM_HOST=0.0.0.0
FOM_PORT=8000
FOM_LOG_LEVEL=INFO

# ── Search geometry ─────────────────────────────────────────────────
FOM_DEFAULT_RADIUS_KM=50
FOM_MAX_RADIUS_KM=250
FOM_POLL_INTERVAL_S=10

# ── OpenSky Network (flight positions) ──────────────────────────────
# Works anonymously. For higher rate limits + 5s resolution, create a
# free account and an API client at https://opensky-network.org/ and
# paste the OAuth2 client credentials here.
# FOM_OPENSKY_CLIENT_ID=your-client-id
# FOM_OPENSKY_CLIENT_SECRET=your-client-secret

# ── LLM: "ask the expert" feature ───────────────────────────────────
# Provider: anthropic | openai | none
FOM_LLM_PROVIDER=anthropic
FOM_LLM_MODEL=claude-sonnet-4-5
# FOM_ANTHROPIC_API_KEY=sk-ant-...
# For OpenAI-compatible providers instead:
# FOM_LLM_PROVIDER=openai
# FOM_LLM_MODEL=gpt-4o-mini
# FOM_OPENAI_API_KEY=sk-...
# FOM_OPENAI_BASE_URL=https://api.openai.com/v1

# ── Identify yourself to free APIs (be a good citizen) ──────────────
FOM_USER_AGENT=flights-over-me/1.0 (https://github.com/you/flights-over-me)
