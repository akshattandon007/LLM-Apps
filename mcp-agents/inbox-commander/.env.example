# --- Google Cloud OAuth 2.0 (Gmail API) ---
# Create a Desktop-app OAuth client in Google Cloud Console, enable the Gmail
# API, and fill these in. Or run `python -m src.auth` once with credentials.json
# present to generate token.json interactively.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Anthropic (summaries + reply drafting) ---
# Optional: without it, Inbox Commander uses deterministic fallback templates.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
