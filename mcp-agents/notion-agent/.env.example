# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env`.

# --- Required ---

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Your Notion integration token. Create an integration at
# https://www.notion.so/profile/integrations and share the pages/databases
# you want the agent to see with that integration.
NOTION_TOKEN=ntn_...

# --- Optional ---

# Override the Claude model. Defaults to the most capable Opus available.
# CLAUDE_MODEL=claude-opus-4-7

# Override the sentence-transformer embedding model.
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the local vector index lives. Defaults to ~/.notion_agent/index
# NOTION_AGENT_INDEX_DIR=/path/to/dir
