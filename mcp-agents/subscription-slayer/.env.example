# Subscription Slayer — Environment Configuration
# Copy to .env and fill in your values

# Email provider credentials (for live inbox scanning)
EMAIL_ADDRESS=you@example.com
EMAIL_PASSWORD=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Bank statement path (optional override)
BANK_STATEMENT_PATH=./data/statements.csv

# Logging
LOG_LEVEL=INFO