# ─────────────────────────────────────────────────────────
#  SpendLens — Environment Variables
# ─────────────────────────────────────────────────────────

# Required: Anthropic API key (https://console.anthropic.com/)
# Needed for RAG Q&A. Analytics work without it.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Claude model to use (default: claude-sonnet-4-5)
# Options: claude-opus-4-5, claude-sonnet-4-5, claude-haiku-4-5
CLAUDE_MODEL=claude-sonnet-4-5

# Optional: HuggingFace embedding model (default: all-MiniLM-L6-v2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: Max tokens for Claude response (default: 2048)
MAX_TOKENS=2048

# Optional: Number of document chunks to retrieve per query (default: 10)
# Higher = more transactions in context but slower responses
RETRIEVAL_K=10

# ─────────────────────────────────────────────────────────
#  Plaid API (optional — for live bank connections)
# ─────────────────────────────────────────────────────────
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET=your_plaid_secret
# PLAID_ENV=sandbox  # sandbox | development | production
