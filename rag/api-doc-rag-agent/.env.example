# ─────────────────────────────────────────────────────────
#  API RAG Agent — Environment Variables
# ─────────────────────────────────────────────────────────

# Required: Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Claude model to use (defaults to claude-sonnet-4-5)
# Options: claude-opus-4-5, claude-sonnet-4-5, claude-haiku-4-5
CLAUDE_MODEL=claude-sonnet-4-5

# Optional: HuggingFace embedding model (defaults to all-MiniLM-L6-v2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: Max tokens for Claude response
MAX_TOKENS=2048

# Optional: Number of document chunks to retrieve per query
RETRIEVAL_K=5

# Optional: Chunk size for text splitting
CHUNK_SIZE=1000

# Optional: Chunk overlap for text splitting
CHUNK_OVERLAP=200
