# ── Required ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
SLACK_BOT_TOKEN=xoxb-...
OWNER_SLACK_ID=U0123456789          # the Slack user ID the agent serves
SLACK_TEAM_ID=T0123456789           # your workspace ID (needed by the official MCP server)

# ── Recommended ──────────────────────────────────────────────────────────
SLACK_USER_TOKEN=xoxp-...           # needed for DM read scopes

# ── Optional ─────────────────────────────────────────────────────────────
SLACK_MCP_SERVER_CMD=npx -y @modelcontextprotocol/server-slack
TIMEZONE=Europe/London

