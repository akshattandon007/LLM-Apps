# AlphaBrief Configuration
# API keys are optional — all agents fall back to simulated/mock data when keys are absent.

# Optional: News API key for sentiment agent
# Get one at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Optional: Finnhub API key for real-time news
# Get one at https://finnhub.io/
FINNHUB_KEY=your_finnhub_key_here

# Default portfolio (comma-separated tickers)
DEFAULT_PORTFOLIO=AAPL,MSFT,GOOGL,AMZN,NVDA