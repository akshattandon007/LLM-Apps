# API key for the observability platform (logs, metrics, deployments)
OBSERVABILITY_API_KEY=changeme

# Base URL for the observability API (real mode only)
OBSERVABILITY_BASE_URL=https://observability.example.com

# Path to the incident history database (JSONL). Defaults to ./data/incidents.jsonl
INCIDENT_DB_PATH=/data/LLM-Apps/advanced-ai-agents/icarus/data/incidents.jsonl

# Real-mode RCA endpoint (optional — reserved for LLM-backed reasoning)
RCA_API_URL=

# Set to 1 to auto-approve all remediation actions (CI/automation only)
ICARUS_AUTO_APPROVE=0