# SketchIt backend configuration
# Copy this file to `.env` and fill in your values, or export these as
# environment variables before running `python server.py`.

# Required: Anthropic API key
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: model to use (default: claude-opus-4-5)
# Other options: claude-sonnet-4-5 (faster, cheaper)
SKETCHIT_MODEL=claude-opus-4-5

# Optional: port the Flask server listens on (default: 5174)
# If you change this, also update extension/manifest.json host_permissions
# and BACKEND_URL in extension/content.js and extension/popup.js
SKETCHIT_PORT=5174
